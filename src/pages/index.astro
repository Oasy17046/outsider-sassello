---
// src/pages/index.astro - Outsider Sassello (Outsider SSL /// 17046)
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Outsider Sassello — Officina, Abbigliamento, Bottega e Flotta Hepha MY26">
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#0e0e0d" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Outsider SSL" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <div class="min-h-screen bg-[#0e0e0d] text-[#ebe6dd] font-sans overflow-x-hidden pb-20 md:pb-0 selection:bg-[#c4532d] selection:text-[#ebe6dd]">

    <!-- BANNER INSTALLAZIONE PWA -->
    <div id="pwa-install-bar" class="bg-[#161514] border-b border-white/[0.10] px-4 sm:px-6 py-2.5 text-xs text-[#9e9990]">
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
        <div class="flex items-center gap-2.5">
          <svg class="w-4 h-4 text-[#c4532d] shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <rect x="7" y="2" width="10" height="20" rx="1" />
            <line x1="12" y1="18" x2="12.01" y2="18" />
          </svg>
          <span>Salva <strong class="text-[#ebe6dd] font-medium">Outsider SSL /// 17046</strong> sul telefono: credito Card in Euro, cavalletto officina e pacchetti e-bike sempre pronti anche senza rete nel bosco.</span>
        </div>
        <button
          id="pwa-install-trigger"
          class="h-8 px-3 bg-[#1f1e1c] hover:bg-[#c4532d] text-[#ebe6dd] text-xs font-mono-tech border border-white/[0.16] shrink-0 transition-colors duration-150"
        >
          Installa app
        </button>
      </div>
    </div>

    <!-- MODALE GUIDA IPHONE -->
    <div id="ios-guide-modal" class="hidden fixed inset-0 z-50 bg-black/85 flex items-center justify-center p-4">
      <div class="bg-[#161514] border border-white/[0.18] p-6 max-w-sm w-full space-y-5 text-[#ebe6dd]">
        <div class="flex justify-between items-center border-b border-white/[0.10] pb-3">
          <h3 class="text-sm font-mono-tech font-medium text-[#ebe6dd]">Installazione su iPhone</h3>
          <button id="close-ios-modal" class="text-[#9e9990] hover:text-[#ebe6dd] p-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <ol class="list-decimal list-inside text-sm text-[#9e9990] space-y-2.5 leading-relaxed">
          <li>Premi <strong class="text-[#ebe6dd] font-medium">Condividi</strong> in basso su Safari</li>
          <li>Scorri e tocca <strong class="text-[#ebe6dd] font-medium">Aggiungi alla schermata Home</strong></li>
          <li>Conferma in alto a destra per avere la tua Matricola sempre pronta</li>
        </ol>
        <button id="dismiss-ios-modal" class="w-full h-10 bg-[#ebe6dd] hover:bg-white text-[#0e0e0d] font-medium text-sm transition-colors duration-150">
          Ho capito
        </button>
      </div>
    </div>

    <!-- MODALE REGISTRAZIONE / ACCESSO / RIPRISTINO (LIVELLO 01: MATRICOLA DIGITALE) -->
    <div id="profile-modal" class="hidden fixed inset-0 z-50 bg-black/85 flex items-center justify-center p-4 overflow-y-auto">
      <div class="bg-[#161514] border border-white/[0.18] p-6 max-w-md w-full space-y-5 text-[#ebe6dd]">
        <div class="flex justify-between items-start border-b border-white/[0.10] pb-4">
          <div>
            <span class="block text-xs font-mono-tech text-[#c4532d] mb-1">Livello 01 • Matricola Digitale</span>
            <h3 id="modal-profile-title" class="font-display-raw text-2xl tracking-wide text-[#ebe6dd]">Attiva Matricola Digitale</h3>
          </div>
          <button id="close-profile-modal" class="text-[#9e9990] hover:text-[#ebe6dd] p-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <p class="text-sm text-[#9e9990] leading-relaxed">
          Genera gratis il tuo codice <strong class="text-[#ebe6dd] font-medium">SSL-XXXX</strong> per prenotare cavalletto e flotta e-bike. Al primo acquisto o lavoro valido da almeno <strong class="text-[#ebe6dd] font-medium">30,00 €</strong> ritiri gratis la <strong class="text-[#ebe6dd] font-medium">Card Legno (5% cashback)</strong> oppure aggiungi <strong class="text-[#ebe6dd] font-medium">20,00 €</strong> per la <strong class="text-[#ebe6dd] font-medium">Card Metallo 2027 + OASY ASD (10% cashback)</strong>.
        </p>

        <form id="profile-form" class="space-y-4">
          <div>
            <label for="input-name" class="block text-xs font-mono-tech text-[#9e9990] mb-1.5">Nome e cognome</label>
            <input
              type="text"
              id="input-name"
              required
              placeholder="Marco Rossi"
              class="w-full h-11 px-3.5 bg-[#0e0e0d] border border-white/[0.16] text-sm text-[#ebe6dd] placeholder:text-[#69655e] focus:border-[#c4532d] focus:outline-none"
            />
          </div>
          <div>
            <label for="input-phone" class="block text-xs font-mono-tech text-[#9e9990] mb-1.5">Numero WhatsApp</label>
            <input
              type="tel"
              id="input-phone"
              required
              placeholder="347 1234567"
              class="w-full h-11 px-3.5 bg-[#0e0e0d] border border-white/[0.16] font-mono-tech text-sm text-[#ebe6dd] placeholder:text-[#69655e] focus:border-[#c4532d] focus:outline-none"
            />
          </div>
          <button
            type="submit"
            id="profile-submit-btn"
            class="w-full h-11 bg-[#c4532d] hover:bg-[#9e3f1f] text-[#ebe6dd] font-medium text-sm transition-colors duration-150"
          >
            Attiva Matricola Digitale (Gratuita)
          </button>
        </form>

        <div class="border-t border-white/[0.10] pt-4 space-y-3">
          <span class="block text-xs text-[#9e9990]">Hai già una matricola o una Card fisica? Ripristina o salva il codice:</span>
          <div class="grid grid-cols-2 gap-3">
            <button
              id="import-token-btn"
              type="button"
              class="h-10 bg-[#1f1e1c] hover:bg-[#2b2926] border border-white/[0.14] text-xs font-mono-tech text-[#ebe6dd] transition-colors duration-150"
            >
              Accedi con codice
            </button>
            <button
              id="export-token-btn"
              type="button"
              class="hidden h-10 bg-[#1f1e1c] hover:bg-[#2b2926] border border-white/[0.14] text-xs font-mono-tech text-[#ebe6dd] transition-colors duration-150"
            >
              Copia backup
            </button>
          </div>
          <button
            id="logout-profile-btn"
            type="button"
            class="hidden w-full text-center text-xs font-mono-tech text-[#c4532d] hover:underline pt-1"
          >
            Esci dall'account su questo dispositivo
          </button>
        </div>
      </div>
    </div>

    <!-- MODALE BANCONE OPERATORE (PIN PROTETTO) -->
    <div id="admin-modal" class="hidden fixed inset-0 z-50 bg-black/85 flex items-center justify-center p-4">
      <div class="bg-[#161514] text-[#ebe6dd] border border-white/[0.18] p-6 max-w-sm w-full space-y-5">
        <div class="flex justify-between items-center border-b border-white/[0.10] pb-3">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#c4532d]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <rect x="3" y="11" width="18" height="11" rx="1" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
            <h3 class="text-sm font-mono-tech font-medium">Terminale bancone</h3>
          </div>
          <button id="close-admin-modal" class="text-[#9e9990] hover:text-[#ebe6dd] p-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div id="admin-pin-step" class="space-y-4">
          <p class="text-xs text-[#9e9990] leading-relaxed">
            Inserisci il PIN dell'officina per assegnare Card Legno / Card Metallo 2027, accreditare il cashback automatico o scalare credito in Euro al banco.
          </p>
          <input
            type="password"
            id="admin-pin-input"
            maxlength="4"
            placeholder="••••"
            class="w-full h-12 bg-[#0e0e0d] border border-white/[0.18] text-center text-xl font-mono-tech tracking-[0.5em] text-[#ebe6dd] focus:border-[#c4532d] focus:outline-none"
          />
          <button
            id="admin-pin-submit"
            class="w-full h-10 bg-[#ebe6dd] hover:bg-white text-[#0e0e0d] font-medium text-xs transition-colors duration-150"
          >
            Sblocca terminale
          </button>
        </div>

        <div id="admin-actions-step" class="hidden space-y-4 text-xs">
          <div class="space-y-2">
            <span class="block text-xs font-mono-tech text-[#9e9990]">1. Supporto e aliquota Cashback attiva</span>
            <div class="grid grid-cols-2 gap-2">
              <button
                type="button"
                data-set-tier="digitale"
                class="set-tier-btn h-9 bg-[#0e0e0d] hover:border-[#c4532d] border border-white/[0.16] font-mono-tech text-xs text-[#ebe6dd] transition-colors duration-150"
              >
                Digitale (0%)
              </button>
              <button
                type="button"
                data-set-tier="legno"
                class="set-tier-btn h-9 bg-[#0e0e0d] hover:border-[#c4532d] border border-white/[0.16] font-mono-tech text-xs text-[#4d7c5b] transition-colors duration-150"
              >
                Card Legno (5%)
              </button>
              <button
                type="button"
                data-set-tier="metallo"
                class="set-tier-btn h-9 bg-[#0e0e0d] hover:border-[#c4532d] border border-white/[0.16] font-mono-tech text-xs text-[#c4532d] transition-colors duration-150"
              >
                Metallo 2027 (10%)
              </button>
              <button
                type="button"
                data-set-tier="metallo_base"
                class="set-tier-btn h-9 bg-[#0e0e0d] hover:border-[#c4532d] border border-white/[0.16] font-mono-tech text-xs text-[#9e9990] transition-colors duration-150"
              >
                Non rinnovata (5%)
              </button>
            </div>
          </div>

          <div class="space-y-2 pt-3 border-t border-white/[0.10]">
            <label for="admin-receipt-amount" class="block text-xs font-mono-tech text-[#9e9990]">
              2. Scontrino valido (€) → accredita Cashback automatico
            </label>
            <div class="flex gap-2">
              <input
                type="number"
                step="0.01"
                min="0"
                id="admin-receipt-amount"
                placeholder="Es. 140.00"
                class="w-1/2 h-10 px-3 bg-[#0e0e0d] border border-white/[0.16] font-mono-tech text-sm text-[#ebe6dd] focus:border-[#c4532d] focus:outline-none"
              />
              <button
                id="apply-auto-cashback"
                type="button"
                class="w-1/2 h-10 bg-[#4d7c5b] hover:bg-[#3f674b] text-[#ebe6dd] font-medium text-xs transition-colors duration-150"
              >
                Accredita %
              </button>
            </div>
          </div>

          <div class="space-y-2 pt-3 border-t border-white/[0.10]">
            <label for="manual-euro-delta" class="block text-xs font-mono-tech text-[#9e9990]">
              3. Scala credito (max 50% conto) o rettifica manuale (€)
            </label>
            <div class="flex gap-2">
              <input
                type="number"
                step="0.01"
                id="manual-euro-delta"
                placeholder="-10.00 o +5.00"
                class="w-1/2 h-10 px-3 bg-[#0e0e0d] border border-white/[0.16] font-mono-tech text-sm text-[#ebe6dd] focus:border-[#c4532d] focus:outline-none"
              />
              <button
                id="apply-manual-delta"
                type="button"
                class="w-1/2 h-10 bg-[#ebe6dd] hover:bg-white text-[#0e0e0d] font-medium text-xs transition-colors duration-150"
              >
                Applica €
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- NOTIFICA TOAST -->
    <div
      id="app-toast"
      class="hidden fixed top-16 left-1/2 -translate-x-1/2 z-50 bg-[#161514] text-[#ebe6dd] border border-[#c4532d] px-5 py-3 font-mono-tech text-xs shadow-2xl text-center max-w-[90vw]"
    >
      Operazione conclusa
    </div>

    <!-- BLOCCO 0: BARRA CONTESTO & HEADER ARCHITETTONICO -->
    <div class="bg-[#0e0e0d] border-b border-white/[0.10] px-4 sm:px-6 py-2 text-xs font-mono-tech text-[#9e9990]">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-x-6 gap-y-1">
        <span>Piazza della Concezione 11 e 12 • 17046 Sassello (SV)</span>
        <div class="flex items-center gap-4 text-[#ebe6dd]">
          <span>Mar–Dom 09:00–12:30 / 15:30–19:00</span>
          <span class="text-[#69655e]">•</span>
          <span class="text-[#c4532d]">Lun chiuso</span>
        </div>
        <span class="hidden lg:inline text-[#ebe6dd]">Outsider SSL /// 17046</span>
      </div>
    </div>

    <header class="sticky top-0 z-40 border-b border-white/[0.11] bg-[#0e0e0d]/95 px-4 sm:px-6 h-20 flex items-center">
      <div class="max-w-7xl mx-auto w-full flex justify-between items-center gap-6">
        <a href="#" class="flex items-center gap-4 shrink-0">
          <img
            src="/images/logo-outsider.svg"
            onerror="if(!this.dataset.f){this.dataset.f='1';this.src='/image/logo-outsider.svg';}else{this.style.display='none';}"
            alt="Outsider Sassello — Outsider SSL /// 17046"
            class="h-10 sm:h-11 w-auto object-contain block invert"
          />
          <div class="flex flex-col border-l border-white/[0.12] pl-3 sm:pl-4">
            <span class="text-sm font-medium text-[#ebe6dd]">Outsider Sassello</span>
            <span class="text-xs font-mono-tech text-[#c4532d]">Outsider SSL /// 17046</span>
          </div>
        </a>

        <nav class="hidden lg:flex items-center gap-7 text-sm text-[#9e9990]">
          <a href="#flotta" class="hover:text-[#ebe6dd] transition-colors duration-150">Flotta Hepha</a>
          <a href="#bottega" class="hover:text-[#ebe6dd] transition-colors duration-150">Bottega</a>
          <a href="#officina" class="hover:text-[#ebe6dd] transition-colors duration-150">Officina</a>
          <a href="#tessera" class="hover:text-[#ebe6dd] transition-colors duration-150">Card & Cashback</a>
          <a href="#oasy" class="hover:text-[#ebe6dd] transition-colors duration-150">OASY ASD</a>
        </nav>

        <div class="flex items-center gap-3 shrink-0">
          <a
            id="header-wallet-pill"
            href="#tessera"
            class="hidden h-10 px-3.5 border border-white/[0.18] bg-[#161514] hover:border-[#c4532d] text-[#ebe6dd] font-mono-tech text-xs transition-colors duration-150 inline-flex items-center gap-2"
          >
            <span class="w-2 h-2 bg-[#4d7c5b]"></span>
            <span><strong id="header-euro-count" class="font-semibold">0,00 €</strong> <span class="hidden sm:inline text-[#9e9990]">Card</span></span>
          </a>

          <button
            id="edit-profile-btn"
            class="h-10 px-3.5 border border-white/[0.14] bg-[#161514] hover:bg-[#1f1e1c] text-[#ebe6dd] text-xs font-mono-tech transition-colors duration-150 inline-flex items-center gap-2"
          >
            <svg class="w-4 h-4 text-[#9e9990]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
            <span id="header-auth-label">Area soci</span>
          </button>

          <a
            href="#flotta"
            class="hidden sm:inline-flex items-center justify-center h-10 px-4 bg-[#ebe6dd] hover:bg-white text-[#0e0e0d] text-xs font-medium transition-colors duration-150"
          >
            Pacchetti E-Bike
          </a>
        </div>
      </div>
    </header>

    <!-- BLOCCO 1: HERO SCENOGRAFICO A PIENO SCHERMO (PIETRA, MATTONI E ACCIAIO) -->
    <section class="relative border-b border-white/[0.12] bg-[#0e0e0d] overflow-hidden">
      <div class="absolute inset-0">
        <img
          src="/images/bottega-interni.jpg"
          alt="Interno Outsider Sassello: pareti in pietra, volte in mattoni a vista, tubi zincati e biciclette"
          class="w-full h-full object-cover object-center opacity-55"
        />
        <div
          class="absolute inset-0"
          style="background: linear-gradient(90deg, #0e0e0d 0%, rgba(14,14,13,0.92) 46%, rgba(14,14,13,0.42) 100%), linear-gradient(180deg, rgba(14,14,13,0.35) 0%, rgba(14,14,13,0.96) 100%);"
        ></div>
      </div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-16 pb-14 lg:pt-24 lg:pb-16">
        <div class="max-w-3xl space-y-6">
          <div class="inline-flex items-center gap-3 border border-white/[0.16] bg-[#0e0e0d]/85 px-3.5 py-1.5 text-xs font-mono-tech text-[#ebe6dd]">
            <span class="w-2 h-2 bg-[#c4532d]"></span>
            <span>OUTSIDER SSL /// 17046 • SASSELLO • 385 M S.L.M.</span>
          </div>

          <h1 class="font-display-raw text-5xl sm:text-6xl lg:text-7xl leading-[0.98] tracking-tight text-[#ebe6dd]">
            Pietra, mattoni, tubi zincati e bici pronte per il Beigua
          </h1>

          <p class="text-base sm:text-lg text-[#9e9990] leading-relaxed max-w-xl">
            Officina meccanica sul cavalletto, abbigliamento tecnico e streetwear selezionato, campo base per uscire sui crinali. Prezzi chiari in Euro, zero fuffa da catalogo: solo ferro, tessuto e sentieri veri.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="#flotta"
              class="h-12 px-6 bg-[#c4532d] hover:bg-[#9e3f1f] text-[#ebe6dd] text-sm font-medium inline-flex items-center justify-center transition-colors duration-150"
            >
              Pacchetti E-Bike & Guide
            </a>
            <a
              href="#tessera"
              class="h-12 px-6 bg-[#161514]/90 hover:bg-[#1f1e1c] text-[#ebe6dd] text-sm font-medium border border-white/[0.18] inline-flex items-center justify-center transition-colors duration-150"
            >
              Card Legno & Metallo (5% / 10%)
            </a>
          </div>
        </div>

        <!-- Striscia Tecnica & Profilo Altimetrico Sassello -> Monte Beigua -->
        <div class="mt-16 pt-6 border-t border-white/[0.14] grid grid-cols-1 lg:grid-cols-12 gap-6 items-end">
          <div class="lg:col-span-7 grid grid-cols-3 gap-4 font-mono-tech">
            <div class="border-l border-[#c4532d] pl-3">
              <span class="block text-xs text-[#69655e]">Flotta MY26</span>
              <strong class="text-sm sm:text-base font-medium text-[#ebe6dd] mt-0.5 block">6 Alloy + 1 Carbon</strong>
            </div>
            <div class="border-l border-white/[0.16] pl-3">
              <span class="block text-xs text-[#69655e]">Store & Cavalletto</span>
              <strong class="text-sm sm:text-base font-medium text-[#ebe6dd] mt-0.5 block">Wear & Service</strong>
            </div>
            <div class="border-l border-white/[0.16] pl-3">
              <span class="block text-xs text-[#69655e]">Cashback Card</span>
              <strong class="text-sm sm:text-base font-medium text-[#ebe6dd] mt-0.5 block">5% Legno • 10% Metallo</strong>
            </div>
          </div>

          <div class="lg:col-span-5 flex flex-col sm:flex-row lg:flex-col items-start sm:items-center lg:items-end justify-between gap-2">
            <div class="flex items-center gap-4 font-mono-tech text-xs text-[#9e9990]">
              <span>Sassello <strong class="text-[#ebe6dd] font-medium">385 m</strong></span>
              <span>→</span>
              <span>Monte Beigua <strong class="text-[#ebe6dd] font-medium">1.287 m</strong></span>
              <span class="text-[#c4532d] font-medium">+902 m</span>
            </div>
            <svg class="w-full sm:w-64 lg:w-80 h-8 text-[#c4532d]" viewBox="0 0 320 32" fill="none" aria-hidden="true">
              <line x1="0" y1="30" x2="320" y2="30" stroke="rgba(235,230,221,0.14)" stroke-width="1" />
              <path
                d="M0 28 L42 25 L86 26 L132 18 L178 14 L224 5 L268 12 L320 22"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
              />
              <rect x="221" y="2" width="6" height="6" fill="#ebe6dd" />
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOCCO 2: FLOTTA HEPHA MY26 — GRIGLIA ATTACCO FINALE (55 / 69 / 89 / 129 €) -->
    <section id="flotta" class="py-16 px-4 sm:px-6 border-b border-white/[0.11] bg-[#0e0e0d]">
      <div class="max-w-7xl mx-auto space-y-10">
