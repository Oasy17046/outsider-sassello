  <!-- SCRIPT COMPLETO: FLOTTA HEPHA, 3 CARD CASHBACK EURO (0% / 5% / 10%), BANCONE PIN & PWA -->
  <script is:inline>
    const SHOP_WHATSAPP = '393473590128';
    const ADMIN_PIN = '1704';

    function formatEuro(val) {
      return Number(val || 0).toFixed(2).replace('.', ',');
    }

    // 1. SERVICE WORKER
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }

    // 2. CONFIGURATORE PACCHETTI FLOTTA HEPHA (55 / 69 / 89 / 129 €)
    let rentalState = {
      pack: 'Mezza Giornata + Aperitivo (4h • Mar–Dom)',
      price: 69,
      cashbackEligible: true,
      weekdayOnly: false,
      size: 'M (168-180 cm)'
    };

    const rentalDateInput = document.getElementById('rental-date-input');
    if (rentalDateInput) {
      rentalDateInput.value = new Date().toISOString().split('T')[0];
    }

    function updateRentalUI() {
      const priceLabel = document.getElementById('rental-cta-price');
      const summaryLine = document.getElementById('rental-summary-line');
      const bonusNote = document.getElementById('rental-bonus-note');

      if (priceLabel) priceLabel.textContent = `— ${rentalState.price},00 €`;
      if (summaryLine) {
        summaryLine.textContent = `${rentalState.pack} • Taglia ${rentalState.size.split(' ')[0]}`;
      }
      if (bonusNote) {
        if (rentalState.cashbackEligible) {
          const cb5 = formatEuro(rentalState.price * 0.05);
          const cb10 = formatEuro(rentalState.price * 0.10);
          bonusNote.textContent = `Con Card: maturi ${cb5} € (Legno 5%) o ${cb10} € (Metallo 10%)`;
          bonusNote.className = 'text-[#4d7c5b] font-mono-tech';
        } else {
          bonusNote.textContent = 'Solo Mar–Ven • Cauzione 300 € al banco • Zero GPX e 0% cashback';
          bonusNote.className = 'text-[#c4532d] font-mono-tech';
        }
      }
    }

    function bindOptionGroup(selector, onSelect) {
      document.querySelectorAll(selector).forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll(selector).forEach((b) => {
            b.classList.remove('border-[#c4532d]', 'bg-[#1f1e1c]');
            b.classList.add('border-white/[0.10]', 'bg-[#0e0e0d]');
          });
          btn.classList.remove('border-white/[0.10]', 'bg-[#0e0e0d]');
          btn.classList.add('border-[#c4532d]', 'bg-[#1f1e1c]');
          onSelect(btn);
          updateRentalUI();
        });
      });
    }

    bindOptionGroup('.rental-pack-btn', (btn) => {
      rentalState.pack = btn.dataset.pack;
      rentalState.price = parseInt(btn.dataset.price, 10);
      rentalState.cashbackEligible = btn.dataset.cashbackEligible === 'true';
      rentalState.weekdayOnly = btn.dataset.weekdayOnly === 'true';
    });

    bindOptionGroup('.rental-size-btn', (btn) => {
      rentalState.size = btn.dataset.size;
    });

    document.getElementById('book-rental-whatsapp-btn')?.addEventListener('click', () => {
      const dateVal = rentalDateInput?.value || '';
      if (dateVal && rentalState.weekdayOnly) {
        const day = new Date(dateVal + 'T12:00:00').getDay();
        if (day === 0 || day === 6) {
          showToast('Solo Noleggio è attivo solo da Martedì a Venerdì: scegli Mezza Giornata + Aperitivo, Giornata + Pranzo o Full Day Guidato.');
          return;
        }
      }

      const profile = getProfile();
      const userRef = profile ? `${profile.name} (${profile.matricola})` : 'Nuovo cliente';
      const cbText = rentalState.cashbackEligible
        ? `\n• Cashback Card: ${formatEuro(rentalState.price * 0.05)} € (Legno) / ${formatEuro(rentalState.price * 0.10)} € (Metallo)`
        : '\n• Note: Cauzione 300 € al banco (solo feriale, 0% cashback)';

      const msg = encodeURIComponent(
        `Ciao Outsider SSL /// 17046! Sono ${userRef}. Vorrei verificare disponibilità per:\n• Formula: ${rentalState.pack}\n• Bici: Hepha All Mountain 7 Alloy (Taglia ${rentalState.size})\n• Data: ${dateVal || 'da concordare'}${cbText}\n• Quota: ${rentalState.price},00 €`
      );
      window.open(`https://wa.me/${SHOP_WHATSAPP}?text=${msg}`, '_blank');
    });

    updateRentalUI();

    // 3. PWA INSTALL
    let deferredPrompt;
    const installBar = document.getElementById('pwa-install-bar');
    const installTrigger = document.getElementById('pwa-install-trigger');
    const iosModal = document.getElementById('ios-guide-modal');
    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;

    if (isStandalone) {
      installBar?.classList.add('hidden');
    } else {
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
      });
      installTrigger?.addEventListener('click', async () => {
        if (isIOS) {
          iosModal?.classList.remove('hidden');
        } else if (deferredPrompt) {
          deferredPrompt.prompt();
          const { outcome } = await deferredPrompt.userChoice;
          if (outcome === 'accepted') installBar?.classList.add('hidden');
          deferredPrompt = null;
        } else {
          alert("Tocca i tre puntini del browser in alto a destra e seleziona 'Aggiungi a schermata Home'.");
        }
      });
    }

    document.getElementById('close-ios-modal')?.addEventListener('click', () => iosModal?.classList.add('hidden'));
    document.getElementById('dismiss-ios-modal')?.addEventListener('click', () => iosModal?.classList.add('hidden'));

    // 4. GESTIONE PROFILO & 3 LIVELLI SOLO EURO (DIGITALE 0% / LEGNO 5% / METALLO 2027 10%)
    const profileModal = document.getElementById('profile-modal');
    const profileForm = document.getElementById('profile-form');

    function normalizeProfile(raw) {
      if (!raw) return null;
      if (typeof raw.creditEuro !== 'number') {
        raw.creditEuro = typeof raw.bulloni === 'number' ? Math.round(raw.bulloni * 2 * 100) / 100 : 0;
        delete raw.bulloni;
        delete raw.pendingTopup;
      }
      if (!raw.tier) raw.tier = 'digitale';
      return raw;
    }

    function getProfile() {
      const data = localStorage.getItem('outsider_profile');
      if (!data) return null;
      try {
        return normalizeProfile(JSON.parse(data));
      } catch {
        return null;
      }
    }

    function setProfile(profile) {
      const clean = normalizeProfile(profile);
      clean.creditEuro = Math.round((clean.creditEuro || 0) * 100) / 100;
      localStorage.setItem('outsider_profile', JSON.stringify(clean));
      renderProfile();
    }

    function getCashbackRate(tier) {
      if (tier === 'metallo') return 0.10;
      if (tier === 'legno' || tier === 'metallo_base') return 0.05;
      return 0;
    }

    function getTierMeta(tier) {
      if (tier === 'metallo') {
        return {
          badge: 'Livello 03 • Card Metallo 2027 (10%)',
          badgeClass: 'text-[#c4532d] font-medium',
          note: 'Card Metallo Edizione 2027 attiva: 10% di cashback in Euro, tessera OASY ASD + copertura CSEN, priorità cavalletto 48h e convenzioni nei locali partner di Sassello.'
        };
      }
      if (tier === 'metallo_base') {
        return {
          badge: 'Card Metallo (Quota ASD scaduta • 5%)',
          badgeClass: 'text-[#9e9990] font-medium',
          note: 'Quota annuale OASY ASD non rinnovata: il tuo credito resta salvo e maturi il 5% in bottega. Rinnova i 20,00 € ASD al banco per ritirare la Card del nuovo anno e tornare al 10% + convenzioni.'
        };
      }
      if (tier === 'legno') {
        return {
          badge: 'Livello 02 • Card Legno (5%)',
          badgeClass: 'text-[#4d7c5b] font-medium',
          note: 'Card Legno attiva: 5% di cashback in Euro sugli acquisti validi, blocco gratuito 24h sui capi contati e nessuna scadenza sul credito.'
        };
      }
      return {
        badge: 'Livello 01 • Matricola Digitale (0%)',
        badgeClass: 'text-[#ebe6dd] font-medium',
        note: 'Passa al banco con un primo acquisto o lavoro da almeno 30,00 €: ritiri gratis la Card Legno (5%) oppure aggiungi 20,00 € per la Card Metallo 2027 + OASY ASD (10%).'
      };
    }

    function openAuthModal() {
      const profile = getProfile();
      const title = document.getElementById('modal-profile-title');
      const submitBtn = document.getElementById('profile-submit-btn');
      const exportBtn = document.getElementById('export-token-btn');
      const logoutBtn = document.getElementById('logout-profile-btn');
      const nameInput = document.getElementById('input-name');
      const phoneInput = document.getElementById('input-phone');

      if (profile) {
        title.textContent = `Socio ${profile.matricola}`;
        nameInput.value = profile.name;
        phoneInput.value = profile.phone;
        submitBtn.textContent = 'Aggiorna dati anagrafici';
        exportBtn.classList.remove('hidden');
        logoutBtn.classList.remove('hidden');
      } else {
        title.textContent = 'Attiva Matricola Digitale';
        nameInput.value = '';
        phoneInput.value = '';
        submitBtn.textContent = 'Attiva Matricola Digitale (Gratuita)';
        exportBtn.classList.add('hidden');
        logoutBtn.classList.add('hidden');
      }
      profileModal?.classList.remove('hidden');
    }

    function createOrUpdateProfile(name, phone) {
      const existing = getProfile();
      if (existing) {
        existing.name = name;
        existing.phone = phone;
        setProfile(existing);
        return false;
      }
      const randomNum = Math.floor(1000 + Math.random() * 9000);
      const profile = {
        name,
        phone,
        matricola: `SSL-${randomNum}`,
        tier: 'digitale',
        creditEuro: 0
      };
      setProfile(profile);
      return true;
    }

    function renderProfile() {
      const profile = getProfile();
      const authLabel = document.getElementById('header-auth-label');
      const walletPill = document.getElementById('header-wallet-pill');
      const guestLock = document.getElementById('wallet-guest-lock');
      const memberCard = document.getElementById('wallet-member-card');

      if (profile) {
        authLabel.textContent = profile.matricola;
        walletPill.classList.remove('hidden');

        guestLock.classList.add('hidden');
        memberCard.classList.remove('hidden');

        document.getElementById('card-holder-name').textContent = profile.name;
        document.getElementById('card-holder-id').textContent = `Matricola: ${profile.matricola} • Tel: ${profile.phone}`;
        document.getElementById('cassa-code-display').textContent = profile.matricola;
        document.getElementById('wallet-euro-display').textContent = formatEuro(profile.creditEuro);
        document.getElementById('header-euro-count').textContent = `${formatEuro(profile.creditEuro)} €`;

        const meta = getTierMeta(profile.tier || 'digitale');
        const badgeEl = document.getElementById('card-tier-badge');
        badgeEl.textContent = meta.badge;
        badgeEl.className = meta.badgeClass;
        document.getElementById('tier-benefits-note').textContent = meta.note;
      } else {
        authLabel.textContent = 'Area soci';
        walletPill.classList.add('hidden');

        guestLock.classList.remove('hidden');
        memberCard.classList.add('hidden');
      }
    }

    function showToast(msg) {
      const t = document.getElementById('app-toast');
      if (t) {
        t.textContent = msg;
        t.classList.remove('hidden');
        setTimeout(() => t.classList.add('hidden'), 3600);
      }
    }

    document.getElementById('edit-profile-btn')?.addEventListener('click', openAuthModal);
    document.getElementById('wallet-guest-cta')?.addEventListener('click', openAuthModal);
    document.getElementById('tier1-activate-btn')?.addEventListener('click', openAuthModal);
    document.getElementById('card-backup-cta')?.addEventListener('click', openAuthModal);
    document.getElementById('footer-auth-btn')?.addEventListener('click', openAuthModal);
    document.getElementById('close-profile-modal')?.addEventListener('click', () => profileModal?.classList.add('hidden'));

    profileForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('input-name').value.trim();
      const phone = document.getElementById('input-phone').value.trim();
      if (name && phone) {
        const isNew = createOrUpdateProfile(name, phone);
        profileModal?.classList.add('hidden');
        showToast(isNew ? 'Matricola Digitale attiva: passa al banco per Card Legno o Card Metallo 2027' : 'Dati socio aggiornati');
      }
    });

    document.getElementById('export-token-btn')?.addEventListener('click', async () => {
      const profile = getProfile();
      if (!profile) return;
      const token = btoa(unescape(encodeURIComponent(JSON.stringify(profile))));
      try {
        await navigator.clipboard.writeText(token);
        showToast('Codice backup copiato negli appunti');
      } catch {
        prompt('Copia manualmente questo codice di ripristino:', token);
      }
    });

    document.getElementById('import-token-btn')?.addEventListener('click', () => {
      const token = prompt('Incolla qui il tuo codice backup Outsider:');
      if (!token) return;
      try {
        const parsed = normalizeProfile(JSON.parse(decodeURIComponent(escape(atob(token.trim())))));
        if (parsed && parsed.matricola && typeof parsed.creditEuro === 'number') {
          setProfile(parsed);
          profileModal?.classList.add('hidden');
          showToast(`Bentornato ${parsed.name}: saldo ${formatEuro(parsed.creditEuro)} € ripristinato`);
        } else {
          showToast('Codice non valido');
        }
      } catch {
        showToast('Codice corrotto o non valido');
      }
    });

    document.getElementById('logout-profile-btn')?.addEventListener('click', () => {
      if (confirm('Vuoi uscire dal tuo profilo su questo telefono? Assicurati di aver salvato il codice backup.')) {
        localStorage.removeItem('outsider_profile');
        profileModal?.classList.add('hidden');
        renderProfile();
        showToast('Disconnesso dal dispositivo');
      }
    });

    // 5. TERMINALE BANCONE (PIN 1704)
    const adminModal = document.getElementById('admin-modal');
    const pinStep = document.getElementById('admin-pin-step');
    const actionsStep = document.getElementById('admin-actions-step');

    document.getElementById('open-admin-btn')?.addEventListener('click', () => {
      const profile = getProfile();
      if (!profile) return openAuthModal();
      pinStep.classList.remove('hidden');
      actionsStep.classList.add('hidden');
      document.getElementById('admin-pin-input').value = '';
      adminModal?.classList.remove('hidden');
    });

    document.getElementById('close-admin-modal')?.addEventListener('click', () => adminModal?.classList.add('hidden'));

    document.getElementById('admin-pin-submit')?.addEventListener('click', () => {
      const val = document.getElementById('admin-pin-input').value;
      if (val !== ADMIN_PIN) {
        showToast('PIN errato: accesso negato');
        return;
      }
      pinStep.classList.add('hidden');
      actionsStep.classList.remove('hidden');
    });

    document.querySelectorAll('.set-tier-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const profile = getProfile();
        if (!profile) return;
        const newTier = btn.dataset.setTier;
        profile.tier = newTier;
        setProfile(profile);
        showToast(`Supporto socio aggiornato (${Math.round(getCashbackRate(newTier) * 100)}% cashback)`);
      });
    });

    document.getElementById('apply-auto-cashback')?.addEventListener('click', () => {
      const profile = getProfile();
      const inputEl = document.getElementById('admin-receipt-amount');
      const spend = parseFloat((inputEl.value || '').replace(',', '.'));
      if (!profile || isNaN(spend) || spend <= 0) {
        showToast('Inserisci un importo scontrino valido in Euro');
        return;
      }
      const rate = getCashbackRate(profile.tier);
      if (rate === 0) {
        showToast('Seleziona prima Card Legno (5%) o Metallo 2027 (10%) per accreditare cashback');
        return;
      }
      const earned = Math.round(spend * rate * 100) / 100;
      profile.creditEuro = Math.round((profile.creditEuro + earned) * 100) / 100;
      inputEl.value = '';
      setProfile(profile);
      adminModal?.classList.add('hidden');
      showToast(`Scontrino ${formatEuro(spend)} € → accreditati +${formatEuro(earned)} € (${Math.round(rate * 100)}%)`);
    });

    document.getElementById('apply-manual-delta')?.addEventListener('click', () => {
      const profile = getProfile();
      const inputEl = document.getElementById('manual-euro-delta');
      const delta = parseFloat((inputEl.value || '').replace(',', '.'));
      if (!profile || isNaN(delta) || delta === 0) return;
      if (profile.creditEuro + delta < 0) {
        showToast('Credito insufficiente per questo scarico');
        return;
      }
      profile.creditEuro = Math.round((profile.creditEuro + delta) * 100) / 100;
      inputEl.value = '';
      setProfile(profile);
      adminModal?.classList.add('hidden');
      showToast(`Movimento registrato: ${delta > 0 ? '+' : ''}${formatEuro(delta)} €`);
    });

    // 6. BLOCCO GRATUITO 24 ORE SUI CAPI IN GIACENZA LIMITATA (RISERVATO CARD LEGNO & METALLO)
    document.querySelectorAll('.lock-item-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const profile = getProfile();
        if (!profile) {
          showToast('Attiva la Matricola o passa al banco per ritirare Card Legno / Card Metallo');
          openAuthModal();
          return;
        }
        if ((profile.tier || 'digitale') === 'digitale') {
          showToast('Il blocco gratuito 24h è attivo per i titolari di Card Legno e Card Metallo');
          return;
        }
        const item = btn.dataset.item;
        if (!confirm(`Confermi di voler bloccare gratuitamente in bottega per 24 ore "${item}"?`)) return;

        btn.textContent = 'Bloccato a tuo nome (24h)';
        btn.disabled = true;
        btn.classList.add('opacity-50');
        const waMsg = encodeURIComponent(
          `Ciao Outsider SSL /// 17046! Sono ${profile.name} (${profile.matricola}). Vorrei bloccare per 24h in bottega "${item}" con la mia Card.`
        );
        showToast(`Riservato per 24 ore: ${item}`);
        window.open(`https://wa.me/${SHOP_WHATSAPP}?text=${waMsg}`, '_blank');
      });
    });

    renderProfile();
  </script>
</BaseLayout>