  <script is:inline>
    const SHOP_WHATSAPP = '393473590128';
    const ADMIN_PIN = '1704';
    const MAX_CLIENT_BIKES = 6;
    const MAX_PER_SIZE = 2;
    const AVAILABLE_SIZES = ['S (155-168 cm)', 'M (168-180 cm)', 'L (180-195 cm)'];

    function formatEuro(val) {
      return Number(val || 0).toFixed(2).replace('.', ',');
    }

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }

    let rentalState = {
      pack: 'Mezza Giornata + Aperitivo (4h • Mar–Dom)',
      price: 69,
      cashbackEligible: true,
      weekdayOnly: false,
      qty: 1,
      sizes: ['M (168-180 cm)']
    };

    const rentalDateInput = document.getElementById('rental-date-input');
    if (rentalDateInput) rentalDateInput.value = new Date().toISOString().split('T')[0];

    function countSize(sizesList, targetSize) {
      return sizesList.filter((s) => s === targetSize).length;
    }

    function rebalanceSizesToCaps(sizesList) {
      const counts = {
        'S (155-168 cm)': 0,
        'M (168-180 cm)': 0,
        'L (180-195 cm)': 0
      };
      const next = [];

      for (const sz of sizesList) {
        if (counts[sz] < MAX_PER_SIZE) {
          counts[sz] += 1;
          next.push(sz);
        } else {
          const fallback = AVAILABLE_SIZES.find((candidate) => counts[candidate] < MAX_PER_SIZE);
          if (fallback) {
            counts[fallback] += 1;
            next.push(fallback);
          }
        }
      }

      while (next.length < rentalState.qty) {
        const slot = AVAILABLE_SIZES.find((candidate) => counts[candidate] < MAX_PER_SIZE);
        if (!slot) break;
        counts[slot] += 1;
        next.push(slot);
      }

      return next.slice(0, rentalState.qty);
    }

    function renderBikeSizes() {
      const container = document.getElementById('rental-sizes-list');
      if (!container) return;
      container.innerHTML = '';

      rentalState.sizes = rebalanceSizesToCaps(rentalState.sizes);

      for (let i = 0; i < rentalState.qty; i++) {
        const row = document.createElement('div');
        row.className = 'flex items-center justify-between gap-2 bg-[#0e0e0d] border border-white/[0.12] px-2.5 py-1.5';

        const label = document.createElement('span');
        label.className = 'text-xs font-mono-tech text-[#c2bdb4] shrink-0';
        label.textContent = rentalState.qty > 1 ? `Bici ${i + 1}:` : 'Taglia:';

        const btnsWrap = document.createElement('div');
        btnsWrap.className = 'grid grid-cols-3 gap-1.5 flex-1 max-w-[230px]';

        AVAILABLE_SIZES.forEach((sz) => {
          const shortTag = sz.split(' ')[0];
          const currentOfThisSize = countSize(rentalState.sizes, sz);
          const isSelected = rentalState.sizes[i] === sz;
          const reachedCapForOtherBikes = !isSelected && currentOfThisSize >= MAX_PER_SIZE;

          const b = document.createElement('button');
          b.type = 'button';
          b.disabled = reachedCapForOtherBikes;
          b.textContent = reachedCapForOtherBikes ? `${shortTag} (max 2)` : shortTag;
          b.className = isSelected
            ? 'py-1.5 border border-[#c4532d] bg-[#1f1e1c] text-xs font-mono-tech text-[#ebe6dd]'
            : reachedCapForOtherBikes
              ? 'py-1.5 border border-white/[0.06] bg-[#11100f] text-[11px] font-mono-tech text-[#69655e] cursor-not-allowed'
              : 'py-1.5 border border-white/[0.12] bg-[#161514] text-xs font-mono-tech text-[#c2bdb4] hover:text-[#ebe6dd]';

          b.addEventListener('click', () => {
            if (reachedCapForOtherBikes) return;
            rentalState.sizes[i] = sz;
            renderBikeSizes();
            updateRentalUI();
          });
          btnsWrap.appendChild(b);
        });

        row.appendChild(label);
        row.appendChild(btnsWrap);
        container.appendChild(row);
      }
    }

    function setBikeQty(nextQty) {
      if (nextQty > MAX_CLIENT_BIKES) {
        rentalState.qty = MAX_CLIENT_BIKES;
        showToast('Flotta clienti: max 6 Hepha AM7 Alloy. Per gruppi oltre 6 scrivici su WhatsApp.');
      } else if (nextQty < 1) {
        rentalState.qty = 1;
      } else {
        rentalState.qty = nextQty;
      }

      rentalState.sizes = rebalanceSizesToCaps(rentalState.sizes);
      renderBikeSizes();
      updateRentalUI();
    }

    function updateRentalUI() {
      const totalEuro = rentalState.price * rentalState.qty;
      const qtyEl = document.getElementById('rental-qty-value');
      const priceLabel = document.getElementById('rental-cta-price');
      const summaryLine = document.getElementById('rental-summary-line');
      const bonusNote = document.getElementById('rental-bonus-note');
      const stockSummary = document.getElementById('size-stock-summary');

      if (qtyEl) qtyEl.textContent = String(rentalState.qty);
      if (priceLabel) priceLabel.textContent = `— ${formatEuro(totalEuro)} €`;

      const remS = MAX_PER_SIZE - countSize(rentalState.sizes, 'S (155-168 cm)');
      const remM = MAX_PER_SIZE - countSize(rentalState.sizes, 'M (168-180 cm)');
      const remL = MAX_PER_SIZE - countSize(rentalState.sizes, 'L (180-195 cm)');
      if (stockSummary) {
        stockSummary.textContent = `Residuo taglie: S ${remS} • M ${remM} • L ${remL} (max 2 per taglia)`;
      }

      const shortSizes = rentalState.sizes.map((s) => s.split(' ')[0]).join(', ');
      if (summaryLine) {
        summaryLine.textContent = `${rentalState.qty} ${rentalState.qty === 1 ? 'bici' : 'bici'} (${shortSizes}) • ${rentalState.pack}`;
      }

      if (bonusNote) {
        if (rentalState.cashbackEligible) {
          bonusNote.textContent = `Con Card: maturi ${formatEuro(totalEuro * 0.05)} € (Legno 5%) o ${formatEuro(totalEuro * 0.10)} € (Metallo 10%) sul totale`;
          bonusNote.className = 'text-xs font-mono-tech text-[#4d7c5b]';
        } else {
          bonusNote.textContent = 'Solo Mar–Ven • Cauzione 300 € a bici • Zero GPX e 0% cashback';
          bonusNote.className = 'text-xs font-mono-tech text-[#c4532d]';
        }
      }
    }

    document.getElementById('rental-qty-minus')?.addEventListener('click', () => {
      setBikeQty(rentalState.qty - 1);
    });

    document.getElementById('rental-qty-plus')?.addEventListener('click', () => {
      setBikeQty(rentalState.qty + 1);
    });

    document.querySelectorAll('.rental-pack-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.rental-pack-btn').forEach((b) => {
          b.classList.remove('border-[#c4532d]', 'bg-[#1f1e1c]');
          b.classList.add('border-white/[0.10]', 'bg-[#0e0e0d]');
        });
        btn.classList.remove('border-white/[0.10]', 'bg-[#0e0e0d]');
        btn.classList.add('border-[#c4532d]', 'bg-[#1f1e1c]');
        rentalState.pack = btn.dataset.pack;
        rentalState.price = parseInt(btn.dataset.price, 10);
        rentalState.cashbackEligible = btn.dataset.cashbackEligible === 'true';
        rentalState.weekdayOnly = btn.dataset.weekdayOnly === 'true';
        updateRentalUI();
      });
    });

    document.getElementById('book-rental-whatsapp-btn')?.addEventListener('click', () => {
      const dateVal = rentalDateInput?.value || '';
      if (dateVal && rentalState.weekdayOnly) {
        const day = new Date(dateVal + 'T12:00:00').getDay();
        if (day === 0 || day === 6) {
          showToast('Solo Noleggio è disponibile solo da Martedì a Venerdì');
          return;
        }
      }
      const totalEuro = rentalState.price * rentalState.qty;
      const profile = getProfile();
      const userRef = profile ? `${profile.name} (${profile.matricola})` : 'Nuovo cliente';
      const sizeBreakdown = rentalState.sizes.map((s, idx) => `Bici ${idx + 1}: ${s}`).join(' | ');
      const cbLine = rentalState.cashbackEligible
        ? `\n• Cashback stimato: ${formatEuro(totalEuro * 0.05)} € (Legno 5%) / ${formatEuro(totalEuro * 0.10)} € (Metallo 10%)`
        : '\n• Note: Cauzione 300 € a bici (solo feriale, 0% cashback)';

      const msg = encodeURIComponent(
        `Ciao Outsider SSL /// 17046! Sono ${userRef}. Info disponibilità:\n• Formula: ${rentalState.pack}\n• Quantità: ${rentalState.qty} Hepha AM7 Alloy (${sizeBreakdown})\n• Data: ${dateVal || 'da concordare'}${cbLine}\n• Totale: ${formatEuro(totalEuro)} €`
      );
      window.open(`https://wa.me/${SHOP_WHATSAPP}?text=${msg}`, '_blank');
    });

    renderBikeSizes();
    updateRentalUI();

    // iOS MODAL
    const iosModal = document.getElementById('ios-guide-modal');
    document.getElementById('close-ios-modal')?.addEventListener('click', () => iosModal?.classList.add('hidden'));
    document.getElementById('dismiss-ios-modal')?.addEventListener('click', () => iosModal?.classList.add('hidden'));

    // PROFILO & 3 CARD CASHBACK EURO
    const profileModal = document.getElementById('profile-modal');
    const profileForm = document.getElementById('profile-form');

    function normalizeProfile(raw) {
      if (!raw) return null;
      if (typeof raw.creditEuro !== 'number') {
        raw.creditEuro = typeof raw.bulloni === 'number' ? Math.round(raw.bulloni * 2 * 100) / 100 : 0;
        delete raw.bulloni;
        delete raw.pendingTopup;
      }
      if (!raw.tier) raw.tier = 'digitale';
      return raw;
    }

    function getProfile() {
      const data = localStorage.getItem('outsider_profile');
      if (!data) return null;
      try { return normalizeProfile(JSON.parse(data)); } catch { return null; }
    }

    function setProfile(profile) {
      const clean = normalizeProfile(profile);
      clean.creditEuro = Math.round((clean.creditEuro || 0) * 100) / 100;
      localStorage.setItem('outsider_profile', JSON.stringify(clean));
      renderProfile();
    }

    function getCashbackRate(tier) {
      if (tier === 'metallo') return 0.10;
      if (tier === 'legno' || tier === 'metallo_base') return 0.05;
      return 0;
    }

    function highlightActiveCardTier(tier) {
      document.querySelectorAll('.card-surface-sheen').forEach((el) => el.classList.remove('is-active'));
      if (tier === 'legno') document.getElementById('card-tier-legno')?.classList.add('is-active');
      else if (tier === 'metallo' || tier === 'metallo_base') document.getElementById('card-tier-metallo')?.classList.add('is-active');
      else document.getElementById('card-tier-digitale')?.classList.add('is-active');
    }

    function openAuthModal() {
      const profile = getProfile();
      const title = document.getElementById('modal-profile-title');
      const submitBtn = document.getElementById('profile-submit-btn');
      const exportBtn = document.getElementById('export-token-btn');
      const logoutBtn = document.getElementById('logout-profile-btn');
      const nameInput = document.getElementById('input-name');
      const phoneInput = document.getElementById('input-phone');
      if (profile) {
        title.textContent = profile.matricola;
        nameInput.value = profile.name;
        phoneInput.value = profile.phone;
        submitBtn.textContent = 'Aggiorna dati';
        exportBtn.classList.remove('hidden');
        logoutBtn.classList.remove('hidden');
      } else {
        title.textContent = 'Attiva Matricola';
        nameInput.value = '';
        phoneInput.value = '';
        submitBtn.textContent = 'Attiva Matricola (0,00 €)';
        exportBtn.classList.add('hidden');
        logoutBtn.classList.add('hidden');
      }
      profileModal?.classList.remove('hidden');
    }

    function renderProfile() {
      const profile = getProfile();
      const authLabel = document.getElementById('header-auth-label');
      const walletPill = document.getElementById('header-wallet-pill');
      const guestLock = document.getElementById('wallet-guest-lock');
      const memberCard = document.getElementById('wallet-member-card');
      if (profile) {
        authLabel.textContent = profile.matricola;
        walletPill.classList.remove('hidden');
        guestLock.classList.add('hidden');
        memberCard.classList.remove('hidden');
        document.getElementById('card-holder-name').textContent = profile.name;
        document.getElementById('card-holder-id').textContent = profile.matricola;
        document.getElementById('cassa-code-display').textContent = profile.matricola;
        document.getElementById('wallet-euro-display').textContent = formatEuro(profile.creditEuro);
        document.getElementById('header-euro-count').textContent = `${formatEuro(profile.creditEuro)} €`;
        const t = profile.tier || 'digitale';
        const badge = document.getElementById('card-tier-badge');
        if (t === 'metallo') badge.textContent = 'Livello 03 • Card Metallo 2027 (10%)';
        else if (t === 'legno') badge.textContent = 'Livello 02 • Card Legno (5%)';
        else if (t === 'metallo_base') badge.textContent = 'Metallo scaduta • 5% bottega';
        else badge.textContent = 'Livello 01 • Matricola Digitale (0%)';
        highlightActiveCardTier(t);
      } else {
        authLabel.textContent = 'Area soci';
        walletPill.classList.add('hidden');
        guestLock.classList.remove('hidden');
        memberCard.classList.add('hidden');
        highlightActiveCardTier('metallo');
      }
    }

    function showToast(msg) {
      const t = document.getElementById('app-toast');
      if (t) {
        t.textContent = msg;
        t.classList.remove('hidden');
        setTimeout(() => t.classList.add('hidden'), 3200);
      }
    }

    document.getElementById('edit-profile-btn')?.addEventListener('click', openAuthModal);
    document.getElementById('wallet-guest-cta')?.addEventListener('click', openAuthModal);
    document.getElementById('tier1-activate-btn')?.addEventListener('click', openAuthModal);
    document.getElementById('card-backup-cta')?.addEventListener('click', openAuthModal);
    document.getElementById('footer-auth-btn')?.addEventListener('click', openAuthModal);
    document.getElementById('close-profile-modal')?.addEventListener('click', () => profileModal?.classList.add('hidden'));

    profileForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('input-name').value.trim();
      const phone = document.getElementById('input-phone').value.trim();
      if (!name || !phone) return;
      const existing = getProfile();
      if (existing) {
        existing.name = name;
        existing.phone = phone;
        setProfile(existing);
        showToast('Dati aggiornati');
      } else {
        setProfile({
          name,
          phone,
          matricola: `SSL-${Math.floor(1000 + Math.random() * 9000)}`,
          tier: 'digitale',
          creditEuro: 0
        });
        showToast('Matricola attivata');
      }
      profileModal?.classList.add('hidden');
    });

    document.getElementById('export-token-btn')?.addEventListener('click', async () => {
      const profile = getProfile();
      if (!profile) return;
      const token = btoa(unescape(encodeURIComponent(JSON.stringify(profile))));
      try { await navigator.clipboard.writeText(token); showToast('Backup copiato'); }
      catch { prompt('Copia codice backup:', token); }
    });

    document.getElementById('import-token-btn')?.addEventListener('click', () => {
      const token = prompt('Incolla codice backup:');
      if (!token) return;
      try {
        const parsed = normalizeProfile(JSON.parse(decodeURIComponent(escape(atob(token.trim())))));
        if (parsed && parsed.matricola && typeof parsed.creditEuro === 'number') {
          setProfile(parsed);
          profileModal?.classList.add('hidden');
          showToast(`Saldo ${formatEuro(parsed.creditEuro)} € ripristinato`);
        }
      } catch { showToast('Codice non valido'); }
    });

    document.getElementById('logout-profile-btn')?.addEventListener('click', () => {
      if (confirm('Uscire dal profilo su questo dispositivo?')) {
        localStorage.removeItem('outsider_profile');
        profileModal?.classList.add('hidden');
        renderProfile();
      }
    });

    const adminModal = document.getElementById('admin-modal');
    const pinStep = document.getElementById('admin-pin-step');
    const actionsStep = document.getElementById('admin-actions-step');

    document.getElementById('open-admin-btn')?.addEventListener('click', () => {
      if (!getProfile()) return openAuthModal();
      pinStep.classList.remove('hidden');
      actionsStep.classList.add('hidden');
      document.getElementById('admin-pin-input').value = '';
      adminModal?.classList.remove('hidden');
    });

    document.getElementById('close-admin-modal')?.addEventListener('click', () => adminModal?.classList.add('hidden'));

    document.getElementById('admin-pin-submit')?.addEventListener('click', () => {
      if (document.getElementById('admin-pin-input').value !== ADMIN_PIN) {
        showToast('PIN errato');
        return;
      }
      pinStep.classList.add('hidden');
      actionsStep.classList.remove('hidden');
    });

    document.querySelectorAll('.set-tier-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const profile = getProfile();
        if (!profile) return;
        profile.tier = btn.dataset.setTier;
        setProfile(profile);
        showToast(`Aggiornato (${Math.round(getCashbackRate(profile.tier) * 100)}%)`);
      });
    });

    document.getElementById('apply-auto-cashback')?.addEventListener('click', () => {
      const profile = getProfile();
      const inputEl = document.getElementById('admin-receipt-amount');
      const spend = parseFloat((inputEl.value || '').replace(',', '.'));
      if (!profile || isNaN(spend) || spend <= 0) return;
      const rate = getCashbackRate(profile.tier);
      if (rate === 0) { showToast('Seleziona Card Legno o Metallo'); return; }
      const earned = Math.round(spend * rate * 100) / 100;
      profile.creditEuro = Math.round((profile.creditEuro + earned) * 100) / 100;
      inputEl.value = '';
      setProfile(profile);
      adminModal?.classList.add('hidden');
      showToast(`+${formatEuro(earned)} € accreditati`);
    });

    document.getElementById('apply-manual-delta')?.addEventListener('click', () => {
      const profile = getProfile();
      const inputEl = document.getElementById('manual-euro-delta');
      const delta = parseFloat((inputEl.value || '').replace(',', '.'));
      if (!profile || isNaN(delta) || delta === 0) return;
      if (profile.creditEuro + delta < 0) { showToast('Credito insufficiente'); return; }
      profile.creditEuro = Math.round((profile.creditEuro + delta) * 100) / 100;
      inputEl.value = '';
      setProfile(profile);
      adminModal?.classList.add('hidden');
      showToast(`${delta > 0 ? '+' : ''}${formatEuro(delta)} € applicati`);
    });

    document.querySelectorAll('.lock-item-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const profile = getProfile();
        if (!profile) { openAuthModal(); return; }
        if ((profile.tier || 'digitale') === 'digitale') {
          showToast('Blocco 24h per Card Legno e Card Metallo');
          return;
        }
        const item = btn.dataset.item;
        if (!confirm(`Bloccare 24h "${item}"?`)) return;
        btn.textContent = 'Bloccato 24h';
        btn.disabled = true;
        btn.classList.add('opacity-50');
        const waMsg = encodeURIComponent(`Ciao Outsider SSL /// 17046! Sono ${profile.name} (${profile.matricola}), blocco 24h: ${item}`);
        window.open(`https://wa.me/${SHOP_WHATSAPP}?text=${waMsg}`, '_blank');
      });
    });

    renderProfile();
  </script>
</BaseLayout>
