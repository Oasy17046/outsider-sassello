---
// src/pages/index.astro - Outsider Sassello (Outsider SSL /// 17046)
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Outsider Sassello — Bici, Officina e Abbigliamento Tecnico">
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#0e0e0d" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Outsider SSL" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <style is:inline>
    .card-surface-sheen {
      position: relative;
      overflow: hidden;
      transition: transform 180ms ease-out, border-color 180ms ease-out, background-color 180ms ease-out;
    }
    .card-surface-sheen::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0;
      background: linear-gradient(115deg, transparent 25%, rgba(235, 230, 221, 0.08) 50%, transparent 75%);
      transition: opacity 220ms ease-out;
    }
    .card-surface-sheen.is-active {
      transform: translateY(-2px);
    }
    .card-surface-sheen.is-active::after {
      opacity: 1;
    }
    .photo-zoom-clean img {
      transition: transform 240ms ease-out;
    }
    .photo-zoom-clean:hover img {
      transform: scale(1.03);
    }
  </style>

  <div class="min-h-screen bg-[#0e0e0d] text-[#ebe6dd] font-sans overflow-x-hidden pb-24 md:pb-8 selection:bg-[#c4532d] selection:text-[#ebe6dd]">

    <!-- MODALE IPHONE -->
    <div id="ios-guide-modal" class="hidden fixed inset-0 z-50 bg-black/85 flex items-center justify-center p-4">
      <div class="bg-[#161514] border border-white/[0.18] p-6 max-w-sm w-full space-y-4 text-[#ebe6dd]">
        <div class="flex justify-between items-center border-b border-white/[0.10] pb-3">
          <h3 class="text-sm font-mono-tech font-medium">Aggiungi su iPhone</h3>
          <button id="close-ios-modal" aria-label="Chiudi guida iPhone" class="text-[#9e9990] hover:text-[#ebe6dd] p-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <ol class="list-decimal list-inside text-xs text-[#9e9990] space-y-2 leading-relaxed">
          <li>Tocca <strong class="text-[#ebe6dd]">Condividi</strong> in basso su Safari</li>
          <li>Seleziona <strong class="text-[#ebe6dd]">Aggiungi a schermata Home</strong></li>
          <li>Conferma in alto a destra</li>
        </ol>
        <button id="dismiss-ios-modal" class="w-full h-11 bg-[#ebe6dd] text-[#0e0e0d] text-xs font-mono-tech font-medium">
          Chiudi
        </button>
      </div>
    </div>

    <!-- MODALE MATRICOLA DIGITALE (LIVELLO 01) -->
    <div id="profile-modal" class="hidden fixed inset-0 z-50 bg-black/85 flex items-center justify-center p-4 overflow-y-auto">
      <div class="bg-[#161514] border border-white/[0.18] p-6 max-w-md w-full space-y-4 text-[#ebe6dd]">
        <div class="flex justify-between items-start border-b border-white/[0.10] pb-3">
          <div>
            <span class="block text-xs font-mono-tech text-[#c4532d]">Livello 01 • Matricola Digitale</span>
            <h3 id="modal-profile-title" class="font-display-raw text-2xl tracking-wide mt-0.5">Attiva Matricola</h3>
          </div>
          <button id="close-profile-modal" aria-label="Chiudi profilo" class="text-[#9e9990] hover:text-[#ebe6dd] p-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <p class="text-xs text-[#9e9990] leading-relaxed">
          Codice <strong class="text-[#ebe6dd]">SSL-XXXX</strong> per prenotazioni e storico. Card fisiche al banco dal 1° acquisto o lavoro da <strong class="text-[#ebe6dd]">30,00 €</strong>.
        </p>

        <form id="profile-form" class="space-y-3">
          <div>
            <label for="input-name" class="block text-xs font-mono-tech text-[#9e9990] mb-1">Nome e cognome</label>
            <input
              type="text"
              id="input-name"
              required
              placeholder="Marco Rossi"
              class="w-full h-11 px-3.5 bg-[#0e0e0d] border border-white/[0.16] text-sm text-[#ebe6dd] placeholder:text-[#69655e] focus:border-[#c4532d] focus:outline-none"
            />
          </div>
          <div>
            <label for="input-phone" class="block text-xs font-mono-tech text-[#9e9990] mb-1">Telefono / WhatsApp</label>
            <input
              type="tel"
              id="input-phone"
              required
              placeholder="347 1234567"
              class="w-full h-11 px-3.5 bg-[#0e0e0d] border border-white/[0.16] font-mono-tech text-sm text-[#ebe6dd] placeholder:text-[#69655e] focus:border-[#c4532d] focus:outline-none"
            />
          </div>
          <button
            type="submit"
            id="profile-submit-btn"
            class="w-full h-11 bg-[#c4532d] hover:bg-[#9e3f1f] text-[#ebe6dd] text-xs font-mono-tech font-medium transition-colors"
          >
            Attiva Matricola (0,00 €)
          </button>
        </form>

        <div class="border-t border-white/[0.10] pt-3 flex flex-wrap items-center gap-2 text-xs font-mono-tech">
          <button
            id="import-token-btn"
            type="button"
            class="h-10 px-3 bg-[#1f1e1c] hover:bg-[#2b2926] border border-white/[0.14] text-[#ebe6dd]"
          >
            Ripristina codice
          </button>
          <button
            id="export-token-btn"
            type="button"
            class="hidden h-10 px-3 bg-[#1f1e1c] hover:bg-[#2b2926] border border-white/[0.14] text-[#ebe6dd]"
          >
            Copia backup
          </button>
          <button
            id="logout-profile-btn"
            type="button"
            class="hidden h-10 px-3 text-[#c4532d] hover:underline"
          >
            Esci
          </button>
        </div>
      </div>
    </div>

    <!-- MODALE BANCONE OPERATORE (PIN 1704) -->
    <div id="admin-modal" class="hidden fixed inset-0 z-50 bg-black/85 flex items-center justify-center p-4">
      <div class="bg-[#161514] text-[#ebe6dd] border border-white/[0.18] p-6 max-w-sm w-full space-y-4">
        <div class="flex justify-between items-center border-b border-white/[0.10] pb-3">
          <h3 class="text-sm font-mono-tech font-medium">Terminale bancone</h3>
          <button id="close-admin-modal" aria-label="Chiudi terminale" class="text-[#9e9990] hover:text-[#ebe6dd] p-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div id="admin-pin-step" class="space-y-3">
          <input
            type="password"
            id="admin-pin-input"
            maxlength="4"
            placeholder="••••"
            class="w-full h-11 bg-[#0e0e0d] border border-white/[0.18] text-center text-xl font-mono-tech tracking-[0.5em] text-[#ebe6dd] focus:border-[#c4532d] focus:outline-none"
          />
          <button
            id="admin-pin-submit"
            class="w-full h-10 bg-[#ebe6dd] hover:bg-white text-[#0e0e0d] font-mono-tech font-medium text-xs"
          >
            Sblocca bancone
          </button>
        </div>

        <div id="admin-actions-step" class="hidden space-y-4 text-xs">
          <div class="grid grid-cols-2 gap-2">
            <button type="button" data-set-tier="digitale" class="set-tier-btn h-10 bg-[#0e0e0d] border border-white/[0.16] font-mono-tech text-[#ebe6dd]">Digitale (0%)</button>
            <button type="button" data-set-tier="legno" class="set-tier-btn h-10 bg-[#0e0e0d] border border-white/[0.16] font-mono-tech text-[#4d7c5b]">Card Legno (5%)</button>
            <button type="button" data-set-tier="metallo" class="set-tier-btn h-10 bg-[#0e0e0d] border border-white/[0.16] font-mono-tech text-[#c4532d]">Metallo 2027 (10%)</button>
            <button type="button" data-set-tier="metallo_base" class="set-tier-btn h-10 bg-[#0e0e0d] border border-white/[0.16] font-mono-tech text-[#9e9990]">Scaduta (5%)</button>
          </div>

          <div class="flex gap-2 pt-3 border-t border-white/[0.10]">
            <input type="number" step="0.01" min="0" id="admin-receipt-amount" placeholder="Scontrino €" class="w-1/2 h-10 px-3 bg-[#0e0e0d] border border-white/[0.16] font-mono-tech text-sm text-[#ebe6dd]" />
            <button id="apply-auto-cashback" type="button" class="w-1/2 h-10 bg-[#4d7c5b] text-[#ebe6dd] font-mono-tech font-medium text-xs">Accredita %</button>
          </div>

          <div class="flex gap-2 pt-3 border-t border-white/[0.10]">
            <input type="number" step="0.01" id="manual-euro-delta" placeholder="-10.00 o +5.00" class="w-1/2 h-10 px-3 bg-[#0e0e0d] border border-white/[0.16] font-mono-tech text-sm text-[#ebe6dd]" />
            <button id="apply-manual-delta" type="button" class="w-1/2 h-10 bg-[#ebe6dd] text-[#0e0e0d] font-mono-tech font-medium text-xs">Applica €</button>
          </div>
        </div>
      </div>
    </div>

    <!-- TOAST -->
    <div
      id="app-toast"
      class="hidden fixed top-20 left-1/2 -translate-x-1/2 z-50 bg-[#161514] text-[#ebe6dd] border border-[#c4532d] px-4 py-2.5 font-mono-tech text-xs text-center max-w-[92vw]"
    >
      Operazione conclusa
    </div>

    <!-- TOP BAR ORARI -->
    <div class="bg-[#0e0e0d] border-b border-white/[0.10] px-4 sm:px-6 py-2 text-xs font-mono-tech text-[#9e9990]">
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-3">
        <span class="truncate">Piazza della Concezione 11–12 • Mar–Dom 09:00–12:30 / 15:30–19:00</span>
        <span class="text-[#c4532d] shrink-0">Lun chiuso</span>
      </div>
    </div>

    <!-- HEADER -->
    <header class="sticky top-0 z-40 border-b border-white/[0.11] bg-[#0e0e0d]/95 px-4 sm:px-6 h-16 flex items-center">
      <div class="max-w-7xl mx-auto w-full flex justify-between items-center gap-3">
        <a href="#" class="flex items-center gap-2.5 min-w-0">
          <img
            src="/images/logo-outsider.svg"
            onerror="if(!this.dataset.f){this.dataset.f='1';this.src='/image/logo-outsider.svg';}else{this.style.display='none';}"
            alt="Outsider Sassello"
            class="h-8 w-auto object-contain block invert shrink-0"
          />
          <span class="text-sm font-medium text-[#ebe6dd] truncate">
            Outsider <span class="font-mono-tech text-xs text-[#c4532d]">SSL /// 17046</span>
          </span>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-xs font-mono-tech text-[#9e9990]">
          <a href="#flotta" class="hover:text-[#ebe6dd]">Flotta</a>
          <a href="#bottega" class="hover:text-[#ebe6dd]">Bottega</a>
          <a href="#officina" class="hover:text-[#ebe6dd]">Officina</a>
          <a href="#tessera" class="hover:text-[#ebe6dd]">Card 5%/10%</a>
          <a href="https://www.asdoasy.it" target="_blank" rel="noopener noreferrer" class="hover:text-[#ebe6dd]">OASY ASD</a>
        </nav>

        <div class="flex items-center gap-2 shrink-0">
          <a
            id="header-wallet-pill"
            href="#tessera"
            class="hidden h-9 px-2.5 border border-white/[0.18] bg-[#161514] text-[#ebe6dd] font-mono-tech text-xs items-center gap-1.5"
          >
            <span class="w-2 h-2 bg-[#4d7c5b]"></span>
            <strong id="header-euro-count">0,00 €</strong>
          </a>

          <button
            id="edit-profile-btn"
            class="h-9 px-3 border border-white/[0.14] bg-[#161514] hover:bg-[#1f1e1c] text-[#ebe6dd] text-xs font-mono-tech"
          >
            <span id="header-auth-label">Area soci</span>
          </button>
        </div>
      </div>
    </header>

    <!-- 1. HERO -->
    <section class="relative border-b border-white/[0.12] bg-[#0e0e0d] overflow-hidden">
      <div class="absolute inset-0">
        <img
          src="/images/bottega-interni.jpg"
          alt="Outsider Sassello — pareti in pietra, mattoni a vista e tubi zincati"
          class="w-full h-full object-cover object-center opacity-50"
        />
        <div
          class="absolute inset-0"
          style="background: linear-gradient(90deg, #0e0e0d 0%, rgba(14,14,13,0.92) 55%, rgba(14,14,13,0.50) 100%), linear-gradient(180deg, rgba(14,14,13,0.35) 0%, rgba(14,14,13,0.96) 100%);"
        ></div>
      </div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-12 sm:py-16 lg:py-20 space-y-6">
        <div class="max-w-2xl space-y-4">
          <span class="block text-xs font-mono-tech text-[#c4532d]">Outsider SSL /// 17046 • Sassello</span>
          <h1 class="font-display-raw text-4xl sm:text-6xl leading-[0.98] tracking-tight text-[#ebe6dd]">
            Bici, officina e abbigliamento tecnico a Sassello
          </h1>
          <p class="text-sm text-[#c2bdb4] leading-relaxed">
            6 Hepha AM7 Alloy clienti + 1 Carbon Ultra per guida • Cavalletto officina • FOX, DC, Roxy, Quiksilver.
          </p>
          <div class="grid grid-cols-1 sm:flex sm:flex-wrap gap-3 pt-1">
            <a href="#flotta" class="h-11 px-5 bg-[#c4532d] hover:bg-[#9e3f1f] text-[#ebe6dd] text-xs font-mono-tech font-medium inline-flex items-center justify-center transition-colors">
              Prenota E-Bike (1–6 bici)
            </a>
            <a href="#tessera" class="h-11 px-5 bg-[#161514] hover:bg-[#1f1e1c] text-[#ebe6dd] text-xs font-mono-tech border border-white/[0.18] inline-flex items-center justify-center transition-colors">
              Card Legno & Metallo
            </a>
          </div>
        </div>

        <div class="pt-4 border-t border-white/[0.14] flex flex-col sm:flex-row sm:items-center justify-between gap-2 font-mono-tech text-xs text-[#c2bdb4]">
          <div>
            <span>Sassello <strong class="text-[#ebe6dd]">385 m</strong></span>
            <span class="mx-1.5">→</span>
            <span>Beigua <strong class="text-[#ebe6dd]">1.287 m</strong></span>
            <span class="ml-1.5 text-[#c4532d]">+902 m</span>
          </div>
          <span class="text-[#9e9990]">Max 2 bici per taglia (S • M • L)</span>
        </div>
      </div>
    </section>

    <!-- 2. FLOTTA HEPHA MY26 (1–6 BICI, MAX 2 PER TAGLIA) -->
    <section id="flotta" class="py-10 sm:py-12 px-4 sm:px-6 border-b border-white/[0.11] bg-[#0e0e0d]">
      <div class="max-w-7xl mx-auto space-y-5">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
          <h2 class="font-display-raw text-3xl sm:text-4xl text-[#ebe6dd]">Flotta Hepha All Mountain 7</h2>
          <span class="text-xs font-mono-tech text-[#c2bdb4]">100 Nm • 800 Wh • 150 mm • Max 2 per taglia</span>
        </div>

        <div id="rental-configurator" class="bg-[#161514] border border-white/[0.14] p-4 sm:p-6 space-y-5">
          <!-- 4 FORMULE -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            <button
              type="button"
              data-pack="Solo Noleggio (4h • Solo Mar–Ven)"
              data-price="55"
              data-cashback-eligible="false"
              data-weekday-only="true"
              class="rental-pack-btn p-4 text-left border border-white/[0.10] bg-[#0e0e0d] flex flex-col justify-between gap-3 transition-colors"
            >
              <div>
                <span class="text-xs font-mono-tech text-[#9e9990]">Solo Mar–Ven • 4h</span>
                <h3 class="font-medium text-sm text-[#c2bdb4] mt-1">Solo Noleggio</h3>
                <p class="text-xs text-[#9e9990] mt-1">Solo bici e casco. Cauzione 300 € a bici. Zero GPX/ristoro.</p>
              </div>
              <span class="font-mono-tech font-semibold text-base text-[#c2bdb4]">55,00 € <span class="text-xs font-normal text-[#9e9990]">/ bici</span></span>
            </button>

            <button
              type="button"
              data-pack="Mezza Giornata + Aperitivo (4h • Mar–Dom)"
              data-price="69"
              data-cashback-eligible="true"
              data-weekday-only="false"
              class="rental-pack-btn p-4 text-left border border-[#c4532d] bg-[#1f1e1c] flex flex-col justify-between gap-3 transition-colors"
            >
              <div>
                <span class="text-xs font-mono-tech text-[#c4532d]">4h • Mar–Dom</span>
                <h3 class="font-medium text-sm text-[#ebe6dd] mt-1">Mezza Giornata + Aperitivo</h3>
                <p class="text-xs text-[#c2bdb4] mt-1">Tracce GPX + aperitivo locale a Sassello.</p>
              </div>
              <span class="font-mono-tech font-semibold text-base text-[#ebe6dd]">69,00 € <span class="text-xs font-normal text-[#9e9990]">/ bici</span></span>
            </button>

            <button
              type="button"
              data-pack="Giornata Intera + Pranzo Tipico (Mar–Dom)"
              data-price="89"
              data-cashback-eligible="true"
              data-weekday-only="false"
              class="rental-pack-btn p-4 text-left border border-white/[0.10] bg-[#0e0e0d] flex flex-col justify-between gap-3 transition-colors"
            >
              <div>
                <span class="text-xs font-mono-tech text-[#c2bdb4]">09:00–17:30 • Mar–Dom</span>
                <h3 class="font-medium text-sm text-[#ebe6dd] mt-1">Giornata + Pranzo Tipico</h3>
                <p class="text-xs text-[#c2bdb4] mt-1">Tracce GPX + pranzo tipico convenzionato.</p>
              </div>
              <span class="font-mono-tech font-semibold text-base text-[#ebe6dd]">89,00 € <span class="text-xs font-normal text-[#9e9990]">/ bici</span></span>
            </button>

            <button
              type="button"
              data-pack="Full Day Guidato + Pranzo + Aperitivo (Max 6 Posti)"
              data-price="129"
              data-cashback-eligible="true"
              data-weekday-only="false"
              class="rental-pack-btn p-4 text-left border border-white/[0.10] bg-[#0e0e0d] flex flex-col justify-between gap-3 transition-colors"
            >
              <div>
                <span class="text-xs font-mono-tech text-[#c2bdb4]">Guida Carbon Ultra • Max 6</span>
                <h3 class="font-medium text-sm text-[#ebe6dd] mt-1">Full Day Guidato</h3>
                <p class="text-xs text-[#c2bdb4] mt-1">Guida dedicata + pranzo + aperitivo in bottega.</p>
              </div>
              <span class="font-mono-tech font-semibold text-base text-[#ebe6dd]">129,00 € <span class="text-xs font-normal text-[#9e9990]">/ bici</span></span>
            </button>
          </div>

          <!-- QUANTITÀ (1–6), TAGLIE (MAX 2 PER TAGLIA) E DATA -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 pt-4 border-t border-white/[0.10]">
            <div class="lg:col-span-4 space-y-2">
              <span class="block text-xs font-mono-tech text-[#c2bdb4]">Numero bici clienti (1–6)</span>
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="rental-qty-minus"
                  aria-label="Riduci numero bici"
                  class="w-11 h-11 bg-[#0e0e0d] hover:bg-[#1f1e1c] border border-white/[0.16] font-mono-tech text-base text-[#ebe6dd]"
                >
                  -
                </button>
                <div class="flex-1 h-11 bg-[#0e0e0d] border border-white/[0.16] flex items-center justify-center font-mono-tech text-xs text-[#ebe6dd]">
                  <span id="rental-qty-value" class="font-semibold text-sm mr-1">1</span>
                  <span class="text-[#c2bdb4]">/ 6 bici</span>
                </div>
                <button
                  type="button"
                  id="rental-qty-plus"
                  aria-label="Aumenta numero bici"
                  class="w-11 h-11 bg-[#0e0e0d] hover:bg-[#1f1e1c] border border-white/[0.16] font-mono-tech text-base text-[#ebe6dd]"
                >
                  +
                </button>
              </div>
              <div id="size-stock-summary" class="text-xs font-mono-tech text-[#9e9990]">
                Residuo taglie: S 2 • M 1 • L 2 (max 2 per taglia)
              </div>
            </div>

            <div class="lg:col-span-5 space-y-2">
              <span class="block text-xs font-mono-tech text-[#c2bdb4]">Taglia per singola bici</span>
              <div id="rental-sizes-list" class="space-y-2"></div>
            </div>

            <div class="lg:col-span-3 space-y-2">
              <label for="rental-date-input" class="block text-xs font-mono-tech text-[#c2bdb4]">Data uscita</label>
              <input
                id="rental-date-input"
                type="date"
                class="w-full h-11 bg-[#0e0e0d] border border-white/[0.16] text-[#ebe6dd] font-mono-tech text-xs px-3 focus:border-[#c4532d] focus:outline-none"
              />
            </div>
          </div>

          <!-- RIEPILOGO & CTA -->
          <div class="pt-4 border-t border-white/[0.10] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
