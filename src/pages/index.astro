  <!-- SCRIPT LOGICA PROFILO PERSONALE & PWA -->
  <script is:inline>
    // 1. REGISTRAZIONE SERVICE WORKER
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch((err) => console.log('SW fail:', err));
      });
    }

    // 2. SISTEMA DI INSTALLAZIONE HOME
    let deferredPrompt;
    const installBar = document.getElementById('pwa-install-bar');
    const installTrigger = document.getElementById('pwa-install-trigger');
    const iosModal = document.getElementById('ios-guide-modal');
    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;

    if (isStandalone) {
      if (installBar) installBar.classList.add('hidden');
    } else {
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        if (installBar) installBar.classList.remove('hidden');
      });

      if (installTrigger) {
        installTrigger.addEventListener('click', async () => {
          if (isIOS) {
            if (iosModal) iosModal.classList.remove('hidden');
          } else if (deferredPrompt) {
            deferredPrompt.prompt();
            const { outcome } = await deferredPrompt.userChoice;
            if (outcome === 'accepted') {
              if (installBar) installBar.classList.add('hidden');
            }
            deferredPrompt = null;
          } else {
            alert("Per installare l'app, tocca i tre puntini del browser in alto a destra e seleziona 'Aggiungi a schermata Home'.");
          }
        });
      }
    }

    document.getElementById('close-ios-modal')?.addEventListener('click', () => iosModal?.classList.add('hidden'));
    document.getElementById('dismiss-ios-modal')?.addEventListener('click', () => iosModal?.classList.add('hidden'));

    // 3. GESTIONE PROFILO CLIENTE
    const profileModal = document.getElementById('profile-modal');
    const profileForm = document.getElementById('profile-form');
    const userBadge = document.getElementById('user-badge');
    const cardHolderName = document.getElementById('card-holder-name');
    const cardHolderId = document.getElementById('card-holder-id');
    const cassaCodeDisplay = document.getElementById('cassa-code-display');

    function getProfile() {
      const data = localStorage.getItem('outsider_profile');
      return data ? JSON.parse(data) : null;
    }

    function saveProfile(name, phone) {
      const randomNum = Math.floor(1000 + Math.random() * 9000);
      const matricola = `SSL-${randomNum}`;
      const profile = { name, phone, matricola, bulloni: 5 }; // 5 Bulloni omaggio
      localStorage.setItem('outsider_profile', JSON.stringify(profile));
      return profile;
    }

    function renderProfile() {
      const profile = getProfile();
      const bDisplay = document.getElementById('wallet-balance-display');
      const hDisplay = document.getElementById('header-bulloni-count');
      const eDisplay = document.getElementById('euro-balance-display');

      if (profile) {
        if (userBadge) userBadge.textContent = `● Socio: ${profile.name} (${profile.matricola})`;
        if (cardHolderName) cardHolderName.textContent = profile.name;
        if (cardHolderId) cardHolderId.textContent = `MATRICOLA: ${profile.matricola}`;
        if (cassaCodeDisplay) cassaCodeDisplay.textContent = profile.matricola;

        if (bDisplay) bDisplay.textContent = profile.bulloni;
        if (hDisplay) hDisplay.textContent = profile.bulloni;
        if (eDisplay) eDisplay.textContent = (profile.bulloni * 2).toFixed(2);
      } else {
        if (userBadge) userBadge.textContent = '● Ospite non registrato';
        if (cardHolderName) cardHolderName.textContent = 'OSPITE TEMPORANEO';
        if (cardHolderId) cardHolderId.textContent = 'MATRICOLA: NESSUNA';
        if (cassaCodeDisplay) cassaCodeDisplay.textContent = 'SSL-OSPITE';
        if (bDisplay) bDisplay.textContent = '0';
        if (hDisplay) hDisplay.textContent = '0';
        if (eDisplay) eDisplay.textContent = '0.00';
      }
    }

    function showToast(msg) {
      const t = document.getElementById('app-toast');
      if (t) {
        t.textContent = msg;
        t.classList.remove('hidden');
        setTimeout(() => t.classList.add('hidden'), 2500);
      }
    }

    document.getElementById('edit-profile-btn')?.addEventListener('click', () => profileModal?.classList.remove('hidden'));
    document.getElementById('hero-setup-profile')?.addEventListener('click', () => profileModal?.classList.remove('hidden'));

    profileForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('input-name').value.trim();
      const phone = document.getElementById('input-phone').value.trim();
      if (name && phone) {
        saveProfile(name, phone);
        profileModal?.classList.add('hidden');
        renderProfile();
        showToast('BENVENUTO! PROFILO ATTIVO + 5 BULLONI ACCREDITATI!');
      }
    });

    document.getElementById('reset-profile-btn')?.addEventListener('click', () => {
      if (confirm('Vuoi cancellare i tuoi dati e i tuoi Bulloni da questo telefono?')) {
        localStorage.removeItem('outsider_profile');
        renderProfile();
        showToast('Profilo rimosso.');
      }
    });

    // Ricarica Bulloni (Simulazione con avviso cassa / predisposta a Stripe)
    document.querySelectorAll('.charge-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        let profile = getProfile();
        if (!profile) {
          profileModal?.classList.remove('hidden');
          return;
        }
        const pack = parseInt(btn.dataset.pack, 10);
        const bonus = parseInt(btn.dataset.bonus, 10);
        const price = btn.dataset.price;
        
        // Per ora accredita localmente e avvisa per il saldo al banco
        profile.bulloni += pack + bonus;
        localStorage.setItem('outsider_profile', JSON.stringify(profile));
        renderProfile();
        showToast(`+${pack + bonus} BULLONI PRENOTATI! Salda ${price}€ al bancone.`);
      });
    });

    // Blocca Pezzi
    document.querySelectorAll('.lock-item-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        let profile = getProfile();
        if (!profile) {
          profileModal?.classList.remove('hidden');
          return;
        }
        const cost = parseInt(btn.dataset.bulloni, 10);
        const item = btn.dataset.item;
        if (profile.bulloni >= cost) {
          profile.bulloni -= cost;
          localStorage.setItem('outsider_profile', JSON.stringify(profile));
          renderProfile();
          showToast(`BLOCCATO! ${item} riservato a tuo nome.`);
          btn.textContent = 'RISERVATO A TE ✓';
          btn.disabled = true;
          btn.classList.add('opacity-50');
        } else {
          showToast('BULLONI INSUFFICIENTI! Ricarica il tuo wallet.');
        }
      });
    });

    // Test Alert
    document.getElementById('test-alert-btn')?.addEventListener('click', () => {
      showToast('🚨 NOTIFICA BOTTEGA: Ultimo Casco FOX rimasto!');
    });

    // Countdown Tubo Zincato
    let timeLeft = 259200;
    const cd = document.getElementById('countdown-pwa');
    setInterval(() => {
      if (timeLeft > 0) timeLeft--;
      const d = Math.floor(timeLeft / 86400);
      const h = Math.floor((timeLeft % 86400) / 3600);
      const m = Math.floor((timeLeft % 3600) / 60);
      const s = timeLeft % 60;
      if (cd) cd.textContent = `${d}G ${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }, 1000);

    renderProfile();
  </script>
</BaseLayout>